set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR ARM)

set(TOOLCHAIN_PREFIX arm-none-eabi-)

find_program(ARM_GCC_EXECUTABLE NAMES ${TOOLCHAIN_PREFIX}gcc)
if(NOT ARM_GCC_EXECUTABLE)
    message(FATAL_ERROR "${TOOLCHAIN_PREFIX}gcc was not found in PATH")
endif()

get_filename_component(ARM_TOOLCHAIN_DIR "${ARM_GCC_EXECUTABLE}" DIRECTORY)
find_program(ARM_GXX_EXECUTABLE NAMES ${TOOLCHAIN_PREFIX}g++
             PATHS "${ARM_TOOLCHAIN_DIR}" NO_DEFAULT_PATH)
find_program(ARM_OBJCOPY_EXECUTABLE NAMES ${TOOLCHAIN_PREFIX}objcopy
             PATHS "${ARM_TOOLCHAIN_DIR}" NO_DEFAULT_PATH)
find_program(ARM_SIZE_EXECUTABLE NAMES ${TOOLCHAIN_PREFIX}size
             PATHS "${ARM_TOOLCHAIN_DIR}" NO_DEFAULT_PATH)

if(NOT ARM_GXX_EXECUTABLE OR NOT ARM_OBJCOPY_EXECUTABLE OR NOT ARM_SIZE_EXECUTABLE)
    message(FATAL_ERROR "Incomplete Arm GNU toolchain in ${ARM_TOOLCHAIN_DIR}")
endif()

# Without that flag CMake is not able to pass test compilation check
set(CMAKE_EXE_LINKER_FLAGS_INIT "--specs=nosys.specs")

set(CMAKE_C_COMPILER "${ARM_GCC_EXECUTABLE}" CACHE FILEPATH "C compiler" FORCE)
set(CMAKE_ASM_COMPILER "${ARM_GCC_EXECUTABLE}" CACHE FILEPATH "ASM compiler" FORCE)
set(CMAKE_CXX_COMPILER "${ARM_GXX_EXECUTABLE}" CACHE FILEPATH "C++ compiler" FORCE)

set(CMAKE_OBJCOPY "${ARM_OBJCOPY_EXECUTABLE}" CACHE FILEPATH "objcopy tool" FORCE)
set(CMAKE_SIZE_UTIL "${ARM_SIZE_EXECUTABLE}" CACHE FILEPATH "size tool" FORCE)

set(CMAKE_FIND_ROOT_PATH "${ARM_TOOLCHAIN_DIR}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
